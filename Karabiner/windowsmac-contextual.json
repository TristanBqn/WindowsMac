{
  "title": "WindowsMac — Contextual shortcuts",
  "rules": [
    {
      "description": "WindowsMac — reliable Alt+Tab state",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_option",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            { "set_variable": { "name": "windowsmac_app_switcher_active", "value": 0 } },
            { "key_code": "left_option" }
          ],
          "to_if_other_key_pressed": [
            {
              "other_keys": [
                {
                  "key_code": "tab",
                  "modifiers": { "optional": ["any"] }
                }
              ],
              "to": [
                { "set_variable": { "name": "windowsmac_app_switcher_active", "value": 1 } },
                { "key_code": "left_command" }
              ]
            }
          ],
          "to_after_key_up": [
            { "set_variable": { "name": "windowsmac_app_switcher_active", "value": 0 } }
          ],
          "conditions": [
            { "type": "variable_if", "name": "windowsmac_enabled", "value": 1 }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "right_option",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            { "set_variable": { "name": "windowsmac_app_switcher_active", "value": 0 } },
            { "key_code": "right_option" }
          ],
          "to_if_other_key_pressed": [
            {
              "other_keys": [
                {
                  "key_code": "tab",
                  "modifiers": { "optional": ["any"] }
                }
              ],
              "to": [
                { "set_variable": { "name": "windowsmac_app_switcher_active", "value": 1 } },
                { "key_code": "right_command" }
              ]
            }
          ],
          "to_after_key_up": [
            { "set_variable": { "name": "windowsmac_app_switcher_active", "value": 0 } }
          ],
          "conditions": [
            { "type": "variable_if", "name": "windowsmac_enabled", "value": 1 }
          ]
        }
      ]
    },
    {
      "description": "WindowsMac — Windows text navigation",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "delete_or_backspace",
            "modifiers": { "mandatory": ["control"], "optional": ["any"] }
          },
          "to": [
            { "key_code": "delete_or_backspace", "modifiers": ["left_option"] }
          ],
          "conditions": [
            { "type": "variable_if", "name": "windowsmac_enabled", "value": 1 },
            { "type": "expression_if", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'" }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "left_arrow",
            "modifiers": { "mandatory": ["control"], "optional": ["any"] }
          },
          "to": [
            { "key_code": "left_arrow", "modifiers": ["left_option"] }
          ],
          "conditions": [
            { "type": "variable_if", "name": "windowsmac_enabled", "value": 1 },
            { "type": "expression_if", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'" }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "right_arrow",
            "modifiers": { "mandatory": ["control"], "optional": ["any"] }
          },
          "to": [
            { "key_code": "right_arrow", "modifiers": ["left_option"] }
          ],
          "conditions": [
            { "type": "variable_if", "name": "windowsmac_enabled", "value": 1 },
            { "type": "expression_if", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'" }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "up_arrow",
            "modifiers": { "mandatory": ["control"], "optional": ["any"] }
          },
          "to": [
            { "key_code": "up_arrow", "modifiers": ["left_option"] }
          ],
          "conditions": [
            { "type": "variable_if", "name": "windowsmac_enabled", "value": 1 },
            { "type": "expression_if", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'" }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "down_arrow",
            "modifiers": { "mandatory": ["control"], "optional": ["any"] }
          },
          "to": [
            { "key_code": "down_arrow", "modifiers": ["left_option"] }
          ],
          "conditions": [
            { "type": "variable_if", "name": "windowsmac_enabled", "value": 1 },
            { "type": "expression_if", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'" }
          ]
        }
      ]
    },
    {
      "description": "WindowsMac — macOS navigation on Alt arrows",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_arrow",
            "modifiers": { "mandatory": ["option"], "optional": ["any"] }
          },
          "to": [
            { "key_code": "left_arrow", "modifiers": ["left_control"] }
          ],
          "conditions": [
            { "type": "variable_if", "name": "windowsmac_enabled", "value": 1 },
            { "type": "variable_unless", "name": "windowsmac_app_switcher_active", "value": 1 },
            { "type": "frontmost_application_unless", "bundle_identifiers": ["^com\\.apple\\.finder$"] }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "right_arrow",
            "modifiers": { "mandatory": ["option"], "optional": ["any"] }
          },
          "to": [
            { "key_code": "right_arrow", "modifiers": ["left_control"] }
          ],
          "conditions": [
            { "type": "variable_if", "name": "windowsmac_enabled", "value": 1 },
            { "type": "variable_unless", "name": "windowsmac_app_switcher_active", "value": 1 },
            { "type": "frontmost_application_unless", "bundle_identifiers": ["^com\\.apple\\.finder$"] }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "up_arrow",
            "modifiers": { "mandatory": ["option"], "optional": ["any"] }
          },
          "to": [
            { "key_code": "up_arrow", "modifiers": ["left_control"] }
          ],
          "conditions": [
            { "type": "variable_if", "name": "windowsmac_enabled", "value": 1 },
            { "type": "variable_unless", "name": "windowsmac_app_switcher_active", "value": 1 },
            { "type": "frontmost_application_unless", "bundle_identifiers": ["^com\\.apple\\.finder$"] }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "down_arrow",
            "modifiers": { "mandatory": ["option"], "optional": ["any"] }
          },
          "to": [
            { "key_code": "down_arrow", "modifiers": ["left_control"] }
          ],
          "conditions": [
            { "type": "variable_if", "name": "windowsmac_enabled", "value": 1 },
            { "type": "variable_unless", "name": "windowsmac_app_switcher_active", "value": 1 },
            { "type": "frontmost_application_unless", "bundle_identifiers": ["^com\\.apple\\.finder$"] }
          ]
        }
      ]
    },
    {
      "description": "WindowsMac — Finder delete and numbered windows",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "delete_or_backspace",
            "modifiers": { "mandatory": ["control"], "optional": ["caps_lock"] }
          },
          "to": [
            { "key_code": "delete_or_backspace", "modifiers": ["left_command"] }
          ],
          "conditions": [
            { "type": "variable_if", "name": "windowsmac_enabled", "value": 1 },
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.apple\\.finder$"] },
            { "type": "expression_unless", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'" }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "1", "modifiers": { "mandatory": ["control"], "optional": ["caps_lock"] } },
          "to": [ { "send_user_command": { "payload": { "command": "finderActivateWindow", "index": 1 } } } ],
          "conditions": [
            { "type": "variable_if", "name": "windowsmac_enabled", "value": 1 },
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.apple\\.finder$"] },
            { "type": "expression_unless", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'" }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "2", "modifiers": { "mandatory": ["control"], "optional": ["caps_lock"] } },
          "to": [ { "send_user_command": { "payload": { "command": "finderActivateWindow", "index": 2 } } } ],
          "conditions": [
            { "type": "variable_if", "name": "windowsmac_enabled", "value": 1 },
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.apple\\.finder$"] },
            { "type": "expression_unless", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'" }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "3", "modifiers": { "mandatory": ["control"], "optional": ["caps_lock"] } },
          "to": [ { "send_user_command": { "payload": { "command": "finderActivateWindow", "index": 3 } } } ],
          "conditions": [
            { "type": "variable_if", "name": "windowsmac_enabled", "value": 1 },
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.apple\\.finder$"] },
            { "type": "expression_unless", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'" }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "4", "modifiers": { "mandatory": ["control"], "optional": ["caps_lock"] } },
          "to": [ { "send_user_command": { "payload": { "command": "finderActivateWindow", "index": 4 } } } ],
          "conditions": [
            { "type": "variable_if", "name": "windowsmac_enabled", "value": 1 },
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.apple\\.finder$"] },
            { "type": "expression_unless", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'" }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "5", "modifiers": { "mandatory": ["control"], "optional": ["caps_lock"] } },
          "to": [ { "send_user_command": { "payload": { "command": "finderActivateWindow", "index": 5 } } } ],
          "conditions": [
            { "type": "variable_if", "name": "windowsmac_enabled", "value": 1 },
            { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.apple\\.finder$"] },
            { "type": "expression_unless", "expression": "accessibility.focused_ui_element.role_string like 'AXText*'" }
          ]
        }
      ]
    }
  ]
}
